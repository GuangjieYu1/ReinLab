{
  "name": "reinlab-design-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "lint": "tsx tooling/boundaries.ts",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d db",
    "db:migrate:local": "tsx services/control/scripts/migrate.ts --local-test",
    "dev:control": "tsx services/control/src/main.ts",
    "check": "pnpm lint && pnpm test && pnpm build",
    "e2e:legacy": "node e2e/legacy/run.mjs",
    "local:up": "tsx tooling/local/up.ts",
    "local:up22": "bash tooling/local/start.sh",
    "openmaic:up": "bash tooling/local/openmaic-up.sh"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@openmaic/dsl": "^0.11.2",
    "@openmaic/renderer": "^0.1.11",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^5.24.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "subset-font": "^2.9.0",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.20.5",
    "@types/pg": "8.15.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/suncalc": "^1.9.2",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "4.1.11",
    "playwright": "1.64.1",
    "supabase": "2.121.0",
    "tsx": "4.20.6",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}

# 仅变量名与空值；真实凭据通过受保护的本地环境或云密钥注入。
DATABASE_URL=
DATABASE_URL_APP=
SUPABASE_URL=
# 留空时按SUPABASE_URL从JWKS校验ES256/RS256；设置时只接受HS256。
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=reinlab
INTERNAL_SIGNING_KEY=
HATCHET_CLIENT_TOKEN=
HATCHET_CLIENT_TLS_STRATEGY=
FLY_API_TOKEN=
FLY_APP_ACCOUNTS=reinlab-accounts
FLY_REGION=nrt
ACCOUNT_IMAGE=
OPENMAIC_BASE_URL=
OPENMAIC_TOKEN=
MODEL_PRICING_SOURCE=models.dev
MODEL_ROUTE_CHEAP=
MODEL_ROUTE_MID=
MODEL_ROUTE_STRONG=
MODEL_USD_CNY_RATE=
PORT=3001
# Private account control callback and snapshot-only JWT (role=reinlab_snapshot_writer)
REINLAB_CONTROL_URL=
STORAGE_SERVICE_TOKEN=
# 探索台地图（只放地图专用公开 key，服务商端限制 Allowed HTTP origins）。
# 矢量源默认 OpenFreeMap（免 key）；卫星 / 等高线 / 公开 key 留空即置灰并显示"没配置"。
MAP_PUBLIC_KEY=
MAP_VECTOR_TILEJSON=
MAP_VECTOR_GLYPHS=
MAP_VECTOR_ATTRIBUTION=
MAP_SATELLITE_TILEJSON=
MAP_CONTOURS_TILEJSON=
MAP_ATTRIBUTION=
# 计划书 PDF 用的中文黑体（TTF）；留空则用 ~/.local/state/reinlab/fonts/NotoSansSC-VF.ttf。
REINLAB_PDF_FONT_FILE=
# 天气判断用的模型（留空则用 REINLAB_KERNEL_MODEL 或 deepseek-v4-flash）。
REINLAB_WEATHER_JUDGE_MODEL=
# 地点搜索与步行路线：国内高德、海外 openrouteservice（凭据只在服务端进程里）。
AMAP_KEY=
ORS_KEY=
ORS_BASE_URL=
# 计划书字体：用静态 Noto Sans SC（NotoSansSC-Regular.ttf），不要可变字体（-VF），
# 可变字体在 pdf-lib 子集化时会掉字形。由 fontTools 从 VF 生成：
#   python3 -m fontTools.varLib.instancer NotoSansSC-VF.ttf wght=400 -o NotoSansSC-Regular.ttf
# REINLAB_PDF_FONT_FILE=/Users/you/.local/state/reinlab/fonts/NotoSansSC-Regular.ttf

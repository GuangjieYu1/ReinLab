{
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paperId": {
            "type": "string",
            "format": "uuid"
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "required": [
          "paperId",
          "page",
          "quote"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 64
    },
    "confidence": {
      "enum": [
        "low",
        "mid",
        "high"
      ]
    },
    "status": {
      "enum": [
        "hypothesis",
        "supported",
        "refuted"
      ]
    }
  },
  "required": [
    "text",
    "evidence",
    "confidence",
    "status"
  ],
  "additionalProperties": false
}
